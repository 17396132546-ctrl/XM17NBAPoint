<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 原生实时活动通知（超级岛/背屏流转） -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:label="NBA妙享背屏"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.Dark.NoActionBar">

        <!-- 主控界面（用于选择比赛、启动服务与一键投送背屏） -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 专属背屏大字记分牌 Activity（定向投送至 Display 1） -->
        <activity
            android:name=".RearScoreActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.mi17.nbabackscreen.rear"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 后台实时拉取比分并更新超级岛/背屏焦点通知的服务 -->
        <service
            android:name=".ScoreLiveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
